@prefix schema: <http://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix vcard:  <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix cv:     <http://example.com/ns#> .
@prefix dct:    <http://purl.org/dc/terms/> .

cv:Antoine_THIAMENY a schema:Person, foaf:Person ;
  schema:givenName "Antoine" ;
  schema:familyName "THIAMENY" ;
  schema:name "Antoine THIAMENY"@fr ;
  schema:jobTitle "Stage Ingénieur Informatique"@fr ;
  cv:speciality "Système Informatique | Développement Logiciel"@fr ;
  schema:description "Élève ingénieur rigoureux et dynamique, doté d'un excellent sens du relationnel et d'un véritable esprit d'équipe. Ponctuel, polyvalent et passionné par l'informatique, je reste à l'écoute des besoins de ceux qui m'entourent."@fr ;
  schema:telephone "+33787249373" ;
  schema:email "antoine.thiameny@etu.utc.fr" ;
  schema:address [
    a vcard:Address ;
    vcard:locality "Compiègne" ;
    vcard:country-name "France"@fr
  ] ;
  cv:interests ( "Cuisine"@fr "Lecture"@fr "Scoutisme"@fr "Escalade"@fr ) ;
  cv:language [ cv:languageName "Français"@fr ; cv:proficiency "Langue natale"@fr ] ,
              [ cv:languageName "Anglais"@fr ; cv:proficiency "B2" ] ;
  schema:alumniOf cv:UTC ;
  cv:education ( cv:edu_utc cv:edu_bac ) ;
  cv:workExperience ( cv:we_epsf cv:we_weldom cv:we_cafe_oustal ) ;
  cv:skills cv:skills ;
  cv:projects cv:projects ;
  cv:authors ( cv:contact ) ;
  dct:created "2023-10-15"^^xsd:date ;
  dct:modified "2026-09-30"^^xsd:date .

cv:UTC a schema:CollegeOrUniversity ;
  schema:name "Université de Technologie de Compiègne (UTC)"@fr ;
  schema:address [ a vcard:Address ; vcard:locality "Compiègne" ; vcard:country-name "France"@fr ] .

cv:Lycee_Einstein a schema:HighSchool ;
  schema:name "Lycée Albert Einstein"@fr ;
  schema:address [ a vcard:Address ; vcard:locality "Bagnols-sur-Cèze" ; vcard:country-name "France"@fr ] .

cv:edu_utc a schema:EducationalOccupationalCredential ;
  schema:name "Prépa intégrée | Cycle ingénieur, Département Génie Informatique"@fr ;
  schema:recognizedBy cv:UTC ;
  schema:startDate "2021"^^xsd:gYear ;
  schema:endDate "2026"^^xsd:gYear .

cv:edu_bac a schema:EducationalOccupationalCredential ;
  schema:name "Baccalauréat général"@fr ;
  schema:recognizedBy cv:Lycee_Einstein ;
  schema:endDate "2021"^^xsd:gYear ;
  schema:description "Mention Très Bien."@fr .

cv:we_epsf a schema:Role ;
  schema:roleName "Assistant ingénieur"@fr ;
  schema:memberOf [ schema:name "Établissement Public de Sécurité Ferroviaire (EPSF), Amiens, France"@fr ] ;
  schema:startDate "2025-09"^^xsd:gYearMonth ;
  schema:endDate "2026-02"^^xsd:gYearMonth ;
  schema:description "Définition et mise en place des règles de qualité pour la validation des données. Conception d'une pipeline de déclaration automatique des données. Mise en place d'indicateurs de performance sur la qualité des données de sécurité ferroviaire. Analyse de données."@fr .

cv:we_weldom a schema:Role ;
  schema:roleName "Assistant logisticien"@fr ;
  schema:memberOf [ schema:name "Weldom, Bagnols-sur-Cèze, France"@fr ] ;
  schema:startDate "2022-01"^^xsd:gYearMonth ;
  schema:endDate "2022-02"^^xsd:gYearMonth ;
  schema:description "Supervision des commandes, inventaire et pointage journalier, gestion du stock et préparation des commandes clients."@fr .

cv:we_cafe_oustal a schema:Role ;
  schema:roleName "Assistant cuisinier"@fr ;
  schema:memberOf [ schema:name "Café de l'Oustal, Uzès, France"@fr ] ;
  schema:startDate "2021-07"^^xsd:gYearMonth ;
  schema:endDate "2021-09"^^xsd:gYearMonth ;
  schema:description "Mise en place du poste des entrées et formation des commis de cuisine dans un environnement à fort rythme."@fr .

